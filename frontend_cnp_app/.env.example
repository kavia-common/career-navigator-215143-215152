# PUBLIC_INTERFACE
# Example environment variables for the frontend app.
# Note: Create React App only exposes variables prefixed with REACT_APP_ to the browser.

# Supabase credentials (required)
REACT_APP_SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
REACT_APP_SUPABASE_KEY=YOUR_ANON_PUBLIC_KEY

# App URLs
# Used for redirects and linking; default is derived from window.location in the browser if unset.
REACT_APP_FRONTEND_URL=http://localhost:3000
REACT_APP_BACKEND_URL=
REACT_APP_API_BASE=

# Optional websocket URL
REACT_APP_WS_URL=

# Node env flags
REACT_APP_NODE_ENV=development
REACT_APP_NEXT_TELEMETRY_DISABLED=1
REACT_APP_ENABLE_SOURCE_MAPS=true

# Dev server port/host guidance (CRA respects PORT and HOST; these are documentation hints)
# The CI will set HOST=0.0.0.0 and PORT=3000 to bind externally.
# If you run locally, you can export these before `npm start`:
#   HOST=0.0.0.0 PORT=3000 npm start
REACT_APP_PORT=3000
REACT_APP_TRUST_PROXY=true

# Logging and healthcheck
REACT_APP_LOG_LEVEL=info
REACT_APP_HEALTHCHECK_PATH=/health/supabase

# Feature flags and experiments
REACT_APP_FEATURE_FLAGS={}
REACT_APP_EXPERIMENTS_ENABLED=false
