# Example environment variables for the Career Navigator React app (Create React App)
# Note: CRA only exposes variables at build time if they are prefixed with REACT_APP_.
# Non-prefixed variables (e.g., SUPABASE_URL) will NOT be available to frontend code.

# App/preview configuration
# CRA respects HOST and PORT for the dev server; BROWSER=none prevents auto-opening a browser.
HOST=0.0.0.0
PORT=3000
BROWSER=none

# Public runtime configuration for the app
REACT_APP_SUPABASE_URL=
REACT_APP_SUPABASE_KEY=
REACT_APP_API_BASE=
REACT_APP_BACKEND_URL=
REACT_APP_FRONTEND_URL=
REACT_APP_WS_URL=
REACT_APP_NODE_ENV=development
REACT_APP_NEXT_TELEMETRY_DISABLED=1
REACT_APP_ENABLE_SOURCE_MAPS=true
REACT_APP_PORT=3000
REACT_APP_TRUST_PROXY=false
REACT_APP_LOG_LEVEL=info
REACT_APP_HEALTHCHECK_PATH=/health/supabase
REACT_APP_FEATURE_FLAGS={}
REACT_APP_EXPERIMENTS_ENABLED=false

# Hints:
# - Start locally or in preview:
#   HOST=0.0.0.0 PORT=3000 BROWSER=none npm start
# - Remember: only REACT_APP_* vars are available to frontend code in CRA.
